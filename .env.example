# ──────────────────────────────────────────────────────────────────────────────
# PR Review Bot — Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# 1. Copy this file:        cp .env.example .env
# 2. Fill in your keys below
# 3. NEVER commit your .env file — it is already in .gitignore
#
# For GitHub Actions, add these as repository secrets:
#   GitHub repo → Settings → Secrets and variables → Actions → New repository secret
# ──────────────────────────────────────────────────────────────────────────────


# ── Google Gemini API Key (PRIMARY — recommended) ─────────────────────────────
# Free tier: 1,500 requests/day, 1M token context window, no credit card needed
#
# How to get it (2 minutes):
#   1. Go to https://aistudio.google.com/app/apikey
#   2. Sign in with any Google account
#   3. Click "Create API key" → select or create a project
#   4. Copy the key and paste it below
#
GEMINI_API_KEY=your_gemini_api_key_here


# ── Groq API Key (OPTIONAL — fallback if Gemini fails) ───────────────────────
# Free tier: 14,400 requests/day, llama3-70b-8192 model
#
# How to get it (2 minutes):
#   1. Go to https://console.groq.com
#   2. Sign up with GitHub or Google (no credit card needed)
#   3. Go to API Keys → Create API Key
#   4. Copy the key and paste it below
#
GROQ_API_KEY=your_groq_api_key_here


# ── GitHub Token ──────────────────────────────────────────────────────────────
# Used ONLY for local testing. In GitHub Actions this is auto-provided.
#
# How to get it (for local dev):
#   1. Go to https://github.com/settings/tokens
#   2. Click "Generate new token (classic)"
#   3. Give it a name like "pr-review-bot-local"
#   4. Select scopes: repo (full), read:org (if testing on org repos)
#   5. Copy and paste below
#
GITHUB_TOKEN=your_github_personal_access_token_here


# ── Local testing variables ───────────────────────────────────────────────────
# These are injected automatically in GitHub Actions.
# Set them here only when running the script locally.
#
# Format: owner/repo-name  (e.g. alice/my-project)
GITHUB_REPOSITORY=your_github_username/your_repo_name

# The PR number you want to test against (e.g. 1)
GITHUB_PR_NUMBER=1
